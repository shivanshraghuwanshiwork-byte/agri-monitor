# Telegram bot — get from @BotFather on Telegram
# 1. Open Telegram, search @BotFather
# 2. Send /newbot — pick a name and username
# 3. Copy the token it gives you
TELEGRAM_BOT_TOKEN=123456789:ABCDEFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Telegram chat ID — get from @userinfobot
# 1. Open Telegram, search @userinfobot
# 2. Send it any message
# 3. It replies with your chat id (a number like 987654321)
TELEGRAM_CHAT_ID=987654321
